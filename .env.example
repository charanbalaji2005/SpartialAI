# Copy to .env (start_spatialai.bat loads it) and adjust as needed.

# auto | cuda | cpu
SPATIALAI_DEVICE=auto
# Mixed precision (FP16 autocast) on CUDA
SPATIALAI_FP16=1
SPATIALAI_MAX_UPLOAD_MB=25

# Where projects, the database and downloaded model weights live (defaults: ./storage, ./models)
# SPATIALAI_STORAGE=D:\SpatialAI\storage
# SPATIALAI_MODEL_CACHE=D:\SpatialAI\models

# Model choices (Hugging Face ids). Base/Large depth models need more VRAM.
SPATIALAI_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
SPATIALAI_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
SPATIALAI_SAM_MODEL=facebook/sam-vit-base
SPATIALAI_CLIP_MODEL=openai/clip-vit-base-patch32
SPATIALAI_SEMANTIC_MODEL=nvidia/segformer-b0-finetuned-ade-512-512

# Object detector: grounding_dino (open vocabulary, default) or yolo (fine-tune it with training/)
SPATIALAI_DETECTOR=grounding_dino
SPATIALAI_YOLO_WEIGHTS=yolo11n.pt

# Load models promoted by `train.bat training.promote <task>` from checkpoints/production/
SPATIALAI_USE_FINETUNED=1

# Optional: Stable Fast 3D in its own environment (Best mode). Leave empty to disable.
# SPATIALAI_SF3D_PYTHON=C:\SpatialAI\sf3d-env\Scripts\python.exe
# SPATIALAI_SF3D_REPO=C:\SpatialAI\stable-fast-3d
SPATIALAI_SF3D_TEXTURE=512

# Test mode replaces neural networks with simple stand-ins. Never use for real scenes.
SPATIALAI_MOCK_MODELS=0
